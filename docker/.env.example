# Copy this file to `.env` (never commit or share the copy) and fill it in.

# The password of the PostgreSQL user "indexd". Choose a long random one. Enter
# the same password when `indexd config` asks for the database password. It is
# only used when the database is created: changing it later doesn't change the
# password of an existing database.
POSTGRES_PASSWORD=

# The image tag, the version of the fork, e.g. v0.3.0-rc.1. To update,
# change it and run `docker compose pull` and `docker compose up -d`.
INDEXD_VERSION=

# Optional: the ports on the host. The container ports stay 9980, 9981, 9982.
#INDEXD_ADMIN_PORT=9980
#INDEXD_SYNCER_PORT=9981
#INDEXD_APP_PORT=9982
